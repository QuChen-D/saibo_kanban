{
  "name": "saibo-kanban",
  "version": "0.3.0",
  "description": "AI 与人共用的活看板：草稿进收件箱、人做分拣、字段级修订可回滚，零 token 纠错。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "kanban",
    "taskboard",
    "ai-agent"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./core.js",
    "./store": "./store.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "core.js",
    "store.js",
    "tools.js",
    "bin",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "saibo-board": "bin/board.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check core.js && node --check store.js && node --check tools.js",
    "test": "node test/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuChen-D/saibo_kanban.git"
  },
  "homepage": "https://github.com/QuChen-D/saibo_kanban#readme",
  "bugs": {
    "url": "https://github.com/QuChen-D/saibo_kanban/issues"
  }
}
